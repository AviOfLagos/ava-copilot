{
  "name": "avi-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Avi Brain: Avi Copilot's companion on the Mac (sandboxed code, CLIs, stdio MCP, routines with the browser closed, artifacts).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "avi-brain": "dist/avi-brain.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:agent": "EVE_TELEMETRY_DISABLED=1 eve build --skip-sandbox-prewarm",
    "start": "node dist/avi-brain.mjs start",
    "pair": "node dist/avi-brain.mjs pair",
    "status": "node dist/avi-brain.mjs status",
    "sandbox:build": "node dist/avi-brain.mjs sandbox-build",
    "test": "vitest run",
    "test:eve": "node scripts/build.mjs && EVE_TELEMETRY_DISABLED=1 eve build --skip-sandbox-prewarm && node scripts/smoke-eve.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.67",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ai": "7.0.136",
    "croner": "10.0.1",
    "eve": "0.75.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
