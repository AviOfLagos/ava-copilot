---
// The mark is the panel's presence orb (LiveOrb, white with two capsule eyes) on a graphite tile.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="#0C0E13"></rect>
  <rect x="0.5" y="0.5" width="31" height="31" rx="7.5" fill="none" stroke="#fff" stroke-opacity="0.09"></rect>
  <circle cx="16" cy="16" r="11" fill="#F4F4F5"></circle>
  <rect x="11.5" y="12.4" width="1.7" height="5.2" rx="0.85" fill="#09090B"></rect>
  <rect x="18.8" y="12.4" width="1.7" height="5.2" rx="0.85" fill="#09090B"></rect>
</svg>
