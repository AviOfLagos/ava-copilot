---
// A corner of the knowledge graph, drawn with the graph view's colour rules (projects mint, people periwinkle,
// everything else in the text colour; never amber), that you can point at or tab through: a node lights its links
// and says what it is. Beside it, a cited answer from the same memory.
import { home } from '../content/site';

const { nodes, graphLabel, hint, askLabel, question, answer, sources } = home.memory;

type Kind = keyof typeof nodes;
const N: Record<Kind, { x: number; y: number; r: number }> = {
  project: { x: 270, y: 160, r: 21 },
  meeting: { x: 108, y: 74, r: 14 },
  decision: { x: 440, y: 70, r: 14 },
  person: { x: 92, y: 248, r: 14 },
  chat: { x: 452, y: 236, r: 14 },
  page: { x: 282, y: 292, r: 12 },
};

// [from, to, lit]: the lit links are the ones the answer comes from
const edges: [Kind, Kind, boolean][] = [
  ['project', 'meeting', true],
  ['meeting', 'decision', true],
  ['project', 'decision', true],
  ['person', 'meeting', false],
  ['project', 'person', false],
  ['project', 'chat', true],
  ['chat', 'page', false],
  ['project', 'page', false],
];

// Quieter nodes at the edge, so it reads as part of something larger
const faint = [
  { x: 28, y: 140, to: 'person' as Kind },
  { x: 196, y: 22, to: 'meeting' as Kind },
  { x: 532, y: 150, to: 'chat' as Kind },
  { x: 372, y: 318, to: 'page' as Kind },
  { x: 528, y: 26, to: 'decision' as Kind },
  { x: 20, y: 318, to: 'person' as Kind },
];

const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  return `M${a.x} ${a.y} Q${(mx - dy * 0.12).toFixed(1)} ${(my + dx * 0.12).toFixed(1)} ${b.x} ${b.y}`;
};
const order: Kind[] = ['project', 'meeting', 'decision', 'chat', 'person', 'page'];
---

<div class="bento bento--memory">
  <figure class="card card--graph" data-graph aria-label={graphLabel}>
    <svg class="graph" viewBox="0 0 560 340" role="group">
      <g aria-hidden="true">
        {faint.map((dot, i) => <path class="edge edge--faint" pathLength="1" d={curve(dot, N[dot.to])} style={`--i:${i}`} />)}
        {
          edges.map(([from, to, lit], i) => (
            <path
              class:list={['edge', lit && 'edge--lit']}
              data-edge={`${from} ${to}`}
              pathLength="1"
              d={curve(N[from], N[to])}
              style={`--i:${i}`}
            />
          ))
        }
        {
          faint.map((dot, i) => (
            <g class="node node--faint" style={`--i:${i + 6}`}>
              <circle class="node-back" cx={dot.x} cy={dot.y} r="5" />
              <circle class="node-dot" cx={dot.x} cy={dot.y} r="5" />
            </g>
          ))
        }
      </g>
      {
        order.map((key, i) => {
          const at = N[key];
          const node = nodes[key];
          return (
            <g
              class="node"
              tabindex="0"
              role="img"
              aria-label={`${node.kind}: ${node.label}. ${node.detail}`}
              data-node={key}
              data-kind={node.kind}
              data-label={node.label}
              data-detail={node.detail}
              style={`--i:${i}`}>
              <circle class="node-hit" cx={at.x} cy={at.y} r={at.r + 16} />
              <circle class="node-back" cx={at.x} cy={at.y} r={at.r} />
              <circle
                class:list={['node-dot', key === 'project' && 'node-dot--project', key === 'person' && 'node-dot--person']}
                cx={at.x}
                cy={at.y}
                r={at.r}
              />
              <text class="node-kind" x={at.x} y={at.y - at.r - 9} text-anchor="middle">
                {node.kind}
              </text>
              <text x={at.x} y={at.y + at.r + 19} text-anchor="middle">
                {node.label}
              </text>
            </g>
          );
        })
      }
    </svg>
    <figcaption class="graph-detail" data-graph-detail aria-live="polite">
      <b>{nodes.project.kind} · {nodes.project.label}</b>
      <span>{hint}</span>
    </figcaption>
  </figure>

  <article class="card card--answer" aria-label={question}>
    <p class="card__label">{askLabel}</p>
    <div class="answer">
      <div class="answer__q"><p>{question}</p></div>
      <p class="answer__a">
        {answer}
        <span class="cite">1</span><span class="cite">2</span>
      </p>
      <div class="answer__sources">
        {
          sources.map((source, i) => (
            <span class="cite">
              {i + 1} · {source}
            </span>
          ))
        }
      </div>
    </div>
  </article>
</div>
