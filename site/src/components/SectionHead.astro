---
interface Props {
  id: string;
  kicker: string;
  title: string;
  body?: string | string[];
}
const { id, kicker, title, body } = Astro.props;
const paragraphs = body === undefined ? [] : Array.isArray(body) ? body : [body];
---

<div class="section-head">
  <p class="label kicker">{kicker}</p>
  <h2 class="h2" id={`${id}-title`}>{title}</h2>
  {
    paragraphs.length > 0 && (
      <div class="prose">
        {paragraphs.map(text => (
          <p>{text}</p>
        ))}
      </div>
    )
  }
  <slot />
</div>
