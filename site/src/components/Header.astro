---
// A floating glass pill, sticky at the top: the mark, three links, the theme switch and Install.
import { ArrowRight } from 'lucide-react';
import { PRODUCT, links, nav } from '../content/site';
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  path: string;
}
const { path } = Astro.props;
---

<header class="site-header">
  <div class="site-header__bar">
    <a class="brand" href="/" aria-label={nav.home}>
      <Mark />
      <span>{PRODUCT}</span>
    </a>
    <nav class="site-nav" aria-label={nav.label}>
      <ul>
        {
          nav.items.map(item => (
            <li>
              <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
    <a class="btn btn--cta btn--sm" href={links.install} aria-current={path === links.install ? 'page' : undefined}>
      <span class="btn__label">{nav.install}</span>
      <span class="btn__chip" aria-hidden="true"><ArrowRight strokeWidth={2.2} /></span>
    </a>
  </div>
</header>
