---
import { ArrowRight, Heart } from 'lucide-react';
import { PRODUCT, footer, links } from '../content/site';
import Mark from './Mark.astro';
---

<footer class="site-footer">
  <div class="wrap">
    <section class="footer-band panel-card" aria-labelledby="footer-band-title">
      <div>
        <h2 class="h3" id="footer-band-title">{footer.band.title}</h2>
        <p>{footer.band.body}</p>
      </div>
      <div class="footer-band__actions">
        <a class="btn btn--glass btn--sm" href="/contribute">
          <span class="btn__label">{footer.band.contribute}</span>
          <span class="btn__chip" aria-hidden="true"><ArrowRight strokeWidth={2.2} /></span>
        </a>
        <a class="btn btn--glass btn--sm" href="/donate">
          <span class="btn__label">{footer.band.donate}</span>
          <span class="btn__chip" aria-hidden="true"><Heart strokeWidth={2.2} /></span>
        </a>
      </div>
    </section>
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <a class="brand" href="/" aria-label={`${PRODUCT}, home`}>
          <Mark />
          <span>{PRODUCT}</span>
        </a>
        <p>
          {footer.lineage}{' '}
          <a class="link" href={links.upstream} rel="noopener">{footer.upstreamLabel}</a>{' · '}
          <a class="link" href={links.license} rel="noopener">{footer.licenseLabel}</a>
        </p>
      </div>
      {
        footer.columns.map(column => (
          <nav aria-label={column.title}>
            <h2>{column.title}</h2>
            <ul>
              {column.links.map(link => (
                <li>
                  <a href={link.href} rel={link.href.startsWith('http') ? 'noopener' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="site-footer__base">
      <p>{footer.privacyNote}</p>
      <p>{footer.voiceNote}</p>
      <p>{footer.version}</p>
    </div>
  </div>
  <p class="wordmark wordmark--foot" aria-hidden="true">{PRODUCT}</p>
</footer>
