---
import { ArrowRight, Bell, Download, MonitorSmartphone, PanelRight, Rss, Terminal, Code2 } from 'lucide-react';
import InstallCommand from '../components/InstallCommand.astro';
import { PRODUCT, install, links } from '../content/site';
import Base from '../layouts/Base.astro';
import { pageGraph } from '../lib/seo';
import '../styles/pages.css';
import '../styles/widgets.css';
import UpdateDemo from '../components/widgets/UpdateDemo.astro';

const path = links.install;
const { tabs, script, load, update, remove, voices, brain, paths, notify, connect } = install;
const pathIcons = { download: Download, terminal: Terminal, source: Code2 };
const notifyIcons = [PanelRight, Bell, MonitorSmartphone, Rss];
---

<Base
  title={install.title}
  description={install.description}
  path={path}
  og="install"
  ogAlt={install.ogAlt}
  graph={pageGraph(path, install.title, install.description, install.breadcrumb)}>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">{PRODUCT}</a></li>
          <li><span aria-current="page">{install.breadcrumb}</span></li>
        </ol>
      </nav>
      <h1 class="display">{install.heading}</h1>
      <p class="lede">{install.lede}</p>
    </header>

    <section class="block" aria-labelledby="paths-title">
      <div class="block-head">
        <h2 class="h2" id="paths-title">{install.pathsTitle}</h2>
      </div>
      <ul class="paths">
        {
          paths.map(item => {
            const Icon = pathIcons[item.id as keyof typeof pathIcons];
            return (
              <li>
                <a class="path panel-card" href={item.href} style="height: 100%">
                  <span class={`path__visual path__visual--${item.id}`} aria-hidden="true">
                    {item.id === 'download' && (
                      <>
                        <span class="pv-file">
                          <Icon strokeWidth={1.75} />
                          <span>ava-copilot-latest.zip</span>
                        </span>
                        <span class="pv-arrow" />
                        <span class="pv-folder">Ava Copilot</span>
                      </>
                    )}
                    {item.id === 'terminal' && (
                      <span class="pv-term">
                        <span class="pv-term__prompt">$</span> curl … | bash<span class="pv-term__caret" />
                      </span>
                    )}
                    {item.id === 'source' && (
                      <span class="pv-git">
                        <span class="pv-git__line" />
                        <span class="pv-git__dot" />
                        <span class="pv-git__dot" />
                        <span class="pv-git__dot pv-git__dot--head" />
                        <span class="pv-git__label">feat/restyle</span>
                      </span>
                    )}
                  </span>
                  <h3 class="h3">{item.title}</h3>
                  <p>{item.body}</p>
                  <span>
                    <span class="arrow-link">
                      {item.action} <ArrowRight aria-hidden="true" />
                    </span>
                    <span class="label" style="display: block; margin-top: 6px; text-transform: none; letter-spacing: 0">
                      {item.then}
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="block" id="download" aria-labelledby="download-title">
      <div class="block-head">
        <p class="label">Step 1</p>
        <h2 class="h2" id="download-title">Download it</h2>
      </div>
      <div class="tabs" data-tabs>
        <div class="tabs__list needs-js" role="tablist" aria-label={install.tabsLabel}>
          {
            tabs.map((tab, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                aria-controls={tab.id}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                data-os={tab.id}>
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          tabs.map(tab => (
            <div class="tabs__panel" id={tab.id} data-tab-panel aria-labelledby={`tab-${tab.id}`}>
              <h3 class="tabs__panel-title">{tab.label}</h3>
              {tab.command ? (
                <InstallCommand id={`command-${tab.id}`} command={tab.command} label={`${tab.label}: ${install.tabsLabel}`} />
              ) : (
                <div class="coming">
                  <span class="badge">{tab.badge}</span>
                  <span>install.ps1</span>
                </div>
              )}
              <p class="tabs__note">
                {tab.note}
                {!tab.command && (
                  <>
                    {' '}
                    <a class="link" href={links.releases}>
                      {script.manual.label}
                    </a>
                    .
                  </>
                )}
              </p>
            </div>
          ))
        }
      </div>
      <div class="callout" style="margin-top: 28px; max-width: 820px">
        <p>
          <strong style="color: var(--ink); font-weight: 560">{script.title}.</strong>{' '}
          {script.body}
        </p>
        <p class="hero__links" style="margin-top: 12px">
          <a class="arrow-link" href={script.read.href}>
            <span>{script.read.label}</span>
            <ArrowRight aria-hidden="true" strokeWidth={1.75} />
          </a>
          <a class="arrow-link" href={script.manual.href}>
            <span>{script.manual.label}</span>
            <ArrowRight aria-hidden="true" strokeWidth={1.75} />
          </a>
        </p>
      </div>
    </section>

    <section class="block" id={load.id} aria-labelledby="load-title">
      <div class="block-head">
        <p class="label">Step 2</p>
        <h2 class="h2" id="load-title">{load.title}</h2>
        <p class="prose">{load.body}</p>
      </div>
      <div class="cards">
        {
          load.browsers.map(browser => (
            <section class="card panel-card" aria-labelledby={`load-${browser.name}`}>
              <h3 class="h3" id={`load-${browser.name}`}>
                {browser.name}
              </h3>
              <p class="label" style="text-transform: none; letter-spacing: 0">
                <code>{browser.page}</code>
              </p>
              <ol>
                {browser.steps.map(step => (
                  <li>{step}</li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>
      <p class="callout" style="margin-top: 16px">{load.first}</p>
    </section>

    <section class="block" id={notify.id} aria-labelledby="notify-title">
      <div class="block-head">
        <p class="label">After</p>
        <h2 class="h2" id="notify-title">{notify.title}</h2>
        <p class="prose">{notify.body}</p>
      </div>
      <div class="notify-grid">
      <UpdateDemo />
      <ul class="notify-list">
        {
          notify.items.map((item, index) => {
            const Icon = notifyIcons[index];
            return (
              <li class="way panel-card">
                <span class="way__icon" aria-hidden="true">
                  <Icon />
                </span>
                <h3 class="h3">{item.title}</h3>
                <p>{item.text}</p>
              </li>
            );
          })
        }
      </ul>
      </div>
      <p style="margin-top: var(--s5); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s5)">
        <a class="arrow-link" href={notify.feed.href}>
          {notify.feed.label} <ArrowRight aria-hidden="true" />
        </a>
        <span class="label" style="text-transform: none; letter-spacing: 0">{notify.store}</span>
      </p>
    </section>

    <section class="block" aria-labelledby="keep-title">
      <div class="block-head">
        <p class="label">Later</p>
        <h2 class="h2" id="keep-title">Update or remove it</h2>
      </div>
      <div class="two-col">
        {
          [update, remove].map(item => (
            <section class="card panel-card" id={item.id} aria-labelledby={`${item.id}-title`}>
              <h3 class="h3" id={`${item.id}-title`}>
                {item.title}
              </h3>
              <div class="prose" style="font-size: 15px; line-height: 24px">
                {item.body.map(text => (
                  <p>{text}</p>
                ))}
              </div>
              {'command' in item && item.command && (
                <InstallCommand id={`command-${item.id}`} command={item.command} label={item.title} />
              )}
            </section>
          ))
        }
      </div>
    </section>

    <section class="block" aria-labelledby="extras-title">
      <div class="block-head">
        <p class="label">Optional</p>
        <h2 class="h2" id="extras-title">Local voices and {brain.title}</h2>
      </div>
      <div class="two-col">
        <section class="card panel-card" id={voices.id} aria-labelledby={`${voices.id}-title`}>
          <p><span class="badge">{voices.badge}</span></p>
          <h3 class="h3" id={`${voices.id}-title`}>{voices.title}</h3>
          <div class="prose" style="font-size: 15px; line-height: 24px">
            {voices.body.map(text => <p>{text}</p>)}
          </div>
          <InstallCommand id={`command-${voices.id}`} command={voices.command} label={voices.title} />
        </section>
        <section class="card panel-card" id={brain.id} aria-labelledby={`${brain.id}-title`}>
          <p><span class="badge">{brain.badge}</span></p>
          <h3 class="h3" id={`${brain.id}-title`}>{brain.title}</h3>
          <p class="prose" style="font-size: 15px; line-height: 24px">{brain.body}</p>
          <h4 class="label" style="margin-top: 8px">{brain.addsLabel}</h4>
          <ul class="list">
            {brain.adds.map(item => <li>{item}</li>)}
          </ul>
          <h4 class="label" style="margin-top: 8px">{brain.needsLabel}</h4>
          <ul class="list">
            {brain.needs.map(item => <li>{item}</li>)}
          </ul>
          <p class="prose" style="font-size: 15px; line-height: 24px; margin-top: 4px">{brain.setup}</p>
          <InstallCommand id={`command-${brain.id}`} command={brain.command} label={brain.title} />
        </section>
      </div>
    </section>

    <section class="block" id={connect.id} aria-labelledby={`${connect.id}-title`}>
      <div class="block-head">
        <p class="label">Connect</p>
        <h2 class="h2" id={`${connect.id}-title`}>{connect.title}</h2>
        <p class="prose">{connect.body}</p>
      </div>
      <div class="two-col">
        {
          connect.cards.map(card => (
            <section class="card panel-card" id={card.id} aria-labelledby={`${card.id}-title`}>
              <p><span class="badge">{card.badge}</span></p>
              <h3 class="h3" id={`${card.id}-title`}>{card.title}</h3>
              <ol class="list list--steps">
                {card.steps.map(step => <li>{step}</li>)}
              </ol>
              <p class="prose" style="font-size: 15px; line-height: 24px">{card.note}</p>
            </section>
          ))
        }
      </div>
    </section>
  </div>
  <div style="height: var(--section)"></div>
</Base>
