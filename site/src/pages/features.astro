---
import { ArrowRight } from 'lucide-react';
import { features, projectLinks, statusLabel } from '../content/project';
import type { Status } from '../content/project';
import { PRODUCT, links } from '../content/site';
import Base from '../layouts/Base.astro';
import { pageGraph } from '../lib/seo';
import '../styles/pages.css';

const path = projectLinks.features;
const count = (status: Status) => features.groups.flatMap(group => group.items).filter(item => item.status === status).length;
---

<Base
  title={features.title}
  description={features.description}
  path={path}
  og="home"
  ogAlt={features.ogAlt}
  graph={pageGraph(path, features.title, features.description, features.breadcrumb)}>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">{PRODUCT}</a></li>
          <li><span aria-current="page">{features.breadcrumb}</span></li>
        </ol>
      </nav>
      <h1 class="display">{features.heading}</h1>
      <p class="lede">{features.lede}</p>
      <h2 class="sr-only">{features.legend}</h2>
      <ul class="legend">
        {
          features.legendItems.map(item => (
            <li>
              <span class={`status status--${item.status}`}>
                {statusLabel[item.status]} · {count(item.status)}
              </span>
              {item.text}
            </li>
          ))
        }
      </ul>
    </header>

    <nav class="jump" aria-label={features.jump}>
      <ul>
        {
          features.groups.map(group => (
            <li>
              <a href={`#${group.id}`}>{group.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      features.groups.map((group, index) => (
        <section class="block feature-group" id={group.id} aria-labelledby={`${group.id}-title`}>
          <div class="block-head">
            <p class="label kicker">{String(index + 1).padStart(2, '0')}</p>
            <h2 class="h2" id={`${group.id}-title`}>
              {group.title}
            </h2>
            <p class="prose">{group.lede}</p>
          </div>
          <ul class="feature-grid">
            {group.items.map(item => (
              <li class={`feature panel-card${item.status === 'planned' ? ' feature--planned' : ''}`}>
                <div class="feature__top">
                  <h3>{item.name}</h3>
                  <span class={`status status--${item.status}`}>{statusLabel[item.status]}</span>
                </div>
                <p>{item.body}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="block" id="principles" aria-labelledby="principles-title">
      <div class="block-head">
        <h2 class="h2" id="principles-title">{features.principlesTitle}</h2>
      </div>
      <ol class="rules-list">
        {features.principles.map(rule => <li>{rule}</li>)}
      </ol>
      <p style="margin-top: var(--s6)">
        <a class="btn btn--cta" href={links.install}>
          <span class="btn__label">Install {PRODUCT}</span>
          <span class="btn__chip" aria-hidden="true"><ArrowRight strokeWidth={2.2} /></span>
        </a>
        <a class="arrow-link" href={projectLinks.roadmap} style="margin-left: var(--s5)">
          See what is next <ArrowRight aria-hidden="true" />
        </a>
      </p>
    </section>
  </div>
  <div style="height: var(--section)"></div>
</Base>
