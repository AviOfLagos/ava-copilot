---
/*
 * Link-preview cards, 1200×630. scripts/og.mjs screenshots each one after the build into /og/<slug>.png and then
 * deletes these pages from the output: they are templates, never part of the site. Each card is the site's look in
 * one frame: the two-tone title, the globe's still frame (drawn by the app's own orb code at build), fluted glass.
 */
import Flutes from '../../components/Flutes.astro';
import Globe from '../../components/Globe.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import Mark from '../../components/Mark.astro';
import PrivacyLabel from '../../components/PrivacyLabel.astro';
import { features, ogCards, statusLabel } from '../../content/project';
import { INSTALL_COMMAND, PRODUCT, SITE_URL, og } from '../../content/site';
import Base from '../../layouts/Base.astro';
import '../../styles/home.css';
import '../../styles/og.css';

const cards: Record<string, { kicker: string; title: readonly [string, string] | string[]; group?: string }> = {
  ...og,
  ...ogCards,
};

export function getStaticPaths() {
  return [...Object.keys(og), ...Object.keys(ogCards)].map(slug => ({ params: { slug } }));
}

const slug = Astro.params.slug as string;
const card = cards[slug];
const group = card.group ? features.groups.find(item => item.id === card.group) : undefined;
const host = SITE_URL.replace(/^https?:\/\//, '');
---

<Base title={`${PRODUCT} card`} description="" path={`/og-card/${slug}`} og="home" ogAlt="" noindex bare>
  <div class="ogc" data-slug={slug} data-group={group ? "" : undefined}>
    <Flutes set="hero" />
    <div class="ogc__copy">
      <p class="ogc__brand"><Mark /><span>{PRODUCT}</span></p>
      <div>
        <p class="label ogc__kicker">{card.kicker}</p>
        <p class="ogc__title"><span>{card.title[0]}</span> <span class="ogc__tone">{card.title[1]}</span></p>
      </div>
      <p class="ogc__host">{host}</p>
    </div>
    <div class="ogc__visual">
      <div class="ogc__globe"><Globe /></div>
      {
        slug === 'install' && (
          <div class="ogc__install">
            <InstallCommand id="og-command" command={INSTALL_COMMAND} />
          </div>
        )
      }
      {slug === 'privacy' && <div class="ogc__label"><PrivacyLabel level={2} /></div>}
      {
        group && (
          <ul class="ogc__features">
            {group.items.slice(0, 5).map(item => (
              <li>
                <span class={`ogc__mark ogc__mark--${item.status}`} />
                <span class="ogc__feature">{item.name}</span>
                <span class="ogc__status">{statusLabel[item.status]}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Base>
