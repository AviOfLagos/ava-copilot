---
// The shell every page shares: metadata, theme without a flash, header, footer and the small client script.
import '../../../src/ui/lib/theme.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tailwind.css';
import '../styles/site.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { PRODUCT, SITE_URL, nav } from '../content/site';
import { absolute, jsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  og: 'home' | 'install' | 'privacy';
  ogAlt: string;
  graph?: unknown;
  noindex?: boolean;
  bare?: boolean;
}

const { title, description, path, og, ogAlt, graph, noindex = false, bare = false } = Astro.props;
const canonical = absolute(path);
const ogImage = `${SITE_URL}/og/${og}.png`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0c0e13" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {
      !bare && (
        <script is:inline>
          // Before first paint: mark that scripts run, and apply the saved theme (dark unless chosen otherwise)
          (function () {
            var root = document.documentElement;
            root.setAttribute('data-js', '');
            var choice = 'dark';
            try {
              choice = localStorage.getItem('avi-theme') || 'dark';
            } catch (e) {}
            if (choice === 'system') choice = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            root.setAttribute('data-theme', choice === 'light' ? 'light' : 'dark');
          })();
        </script>
      )
    }
    {graph && <script type="application/ld+json" set:html={jsonLd(graph)} />}
  </head>
  <body>
    <div class="ground" aria-hidden="true"></div>
    {!bare && <a class="skip" href="#main">{nav.skip}</a>}
    {!bare && <Header path={path} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
