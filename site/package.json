{
  "name": "ava-copilot-site",
  "private": true,
  "version": "0.1.0",
  "description": "The marketing and install website for Ava Copilot: static pages, the live gate demo and link previews.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/og.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "og:update": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/og.mjs --update",
    "verify": "node scripts/verify.mjs",
    "narrate": "node scripts/narrate.mjs",
    "render:3d": "node scripts/render-3d.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@radix-ui/react-collapsible": "1.1.21",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "astro": "7.3.8",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "simple-icons": "^16.34.0"
  },
  "devDependencies": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "puppeteer-core": "25.12.0",
    "tailwindcss": "3.4.18",
    "tailwindcss-animate": "1.0.7",
    "three": "^0.186.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
